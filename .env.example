# Railway / bulut dagitimi icin ortam degiskenleri.
# Sirlar SADECE buradan okunur; panel bunlari asla degistiremez ve
# API cevaplarinda gorunmez.

# --- Sirlar (zorunlu) ---
DISCORD_TOKEN=
NVIDIA_API_KEY=

# Panel erisim anahtari. Tanimli degilse API guvenlik nedeniyle kilitlenir.
# Uretmek icin:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_API_KEY=

# --- Panel erisimi ---
# Panelin barindigi origin(ler), virgulle ayrilir. "*" tum kaynaklara izin verir.
# Ornek: https://kullaniciadi.github.io
PANEL_ORIGINS=*

# Railway PORT'u kendisi enjekte eder; yerelde varsayilan 8080'dir.
# PORT=8080

# --- Operasyonel ayarlar (config.json yoksa kullanilir; panel bunlari yazar) ---
BOT_ENABLED=true
GUILD_ID=0
VOICE_CHANNEL_ID=0
GREETING_CHANNEL_ID=0
CHECK_INTERVAL=5

SCHEDULE_ENABLED=false
SCHEDULE_START=09:00
SCHEDULE_END=23:00
TIMEZONE=Europe/Istanbul
